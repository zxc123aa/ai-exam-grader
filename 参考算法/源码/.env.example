PORT=3417
NEWAPI_API_KEY=replace-with-your-key
NEWAPI_BASE_URL=https://fluxnode.org
OCR_MODEL=gemini-3.5-flash
LAYOUT_MODEL=gemini-3.5-flash
MAX_CONCURRENT_OCR=8
MAX_BLOCKS_PER_OCR_REQUEST=3
# Answer-evidence policy; tune from evaluation data instead of changing code.
GRADING_ELIGIBILITY_THRESHOLD=0.8
VERIFICATION_FAILURE_CONFIDENCE_CAP=0.85
EVIDENCE_TEXT_SIMILARITY_MIN=0.68
# Optional USD prices per 1M tokens; leave 0 to report usage only.
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
# Use this when the provider returns only total_tokens.
MODEL_TOTAL_USD_PER_MILLION=0

PORT=3417
DEFAULT_PROVIDER=pomoai
DEFAULT_MODEL=gemini-3.5-flash
AVAILABLE_PROVIDERS=fluxnode_gemini,fluxnode_grok,pomoai,kimi

PROVIDER_FLUXNODE_GEMINI_LABEL=FluxNode · Gemini
PROVIDER_FLUXNODE_GEMINI_BASE_URL=https://fluxnode.org
PROVIDER_FLUXNODE_GEMINI_API_KEY=replace-with-fluxnode-gemini-key
PROVIDER_FLUXNODE_GEMINI_MODELS=gemini-3.5-flash

PROVIDER_FLUXNODE_GROK_LABEL=FluxNode · Grok
PROVIDER_FLUXNODE_GROK_BASE_URL=https://fluxnode.org
PROVIDER_FLUXNODE_GROK_API_KEY=replace-with-fluxnode-grok-key
PROVIDER_FLUXNODE_GROK_MODELS=grok-4.5

PROVIDER_POMOAI_LABEL=PomoAI
PROVIDER_POMOAI_BASE_URL=https://www.pomoai.ai
PROVIDER_POMOAI_API_KEY=replace-with-pomoai-key
PROVIDER_POMOAI_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,grok-4.5,claude-opus-4-8,claude-opus-4-6,gemini-3.5-flash

PROVIDER_KIMI_LABEL=Kimi Coding
PROVIDER_KIMI_BASE_URL=https://api.kimi.com/coding/v1
PROVIDER_KIMI_API_KEY=replace-with-kimi-key
PROVIDER_KIMI_MODELS=kimi-k2.7-code,kimi-k2.7-code-highspeed,kimi-k2.6,kimi-k2.5
PROVIDER_KIMI_TEMPERATURE=1

MODEL_TIMEOUT_MS=180000
MAX_CONCURRENT_OCR=8
MAX_BLOCKS_PER_OCR_REQUEST=3
# Optional USD prices per 1M tokens; leave 0 to report usage only.
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
# Use this when the provider returns only total_tokens.
MODEL_TOTAL_USD_PER_MILLION=0

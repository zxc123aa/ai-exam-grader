# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and acquire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="AI Exam Grader"
STACK_NAME=ai-exam-grader

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=false
SMTP_SSL=False
SMTP_PORT=1025

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Redis and local file storage
REDIS_URL=redis://redis:6379/0
LOCAL_UPLOAD_DIR=

# Scan preprocessing engine for website upload preview/testing
SCAN_ENGINE=scan_stable_v1

# Vision grading provider (keep keys server-side; values can be copied from the reference workbench .env)
VISION_DEFAULT_PROVIDER=pomoai
VISION_DEFAULT_MODEL=gemini-3.5-flash
GRADING_DEFAULT_PROVIDER=pomoai
GRADING_DEFAULT_MODEL=gpt-5.6-sol
VISION_FALLBACK_MODELS=gpt-5.5
VISION_TIMEOUT_SECONDS=180
VISION_MAX_CONCURRENCY=4
PROVIDER_POMOAI_BASE_URL=https://www.pomoai.ai
PROVIDER_POMOAI_API_KEY=
PROVIDER_FLUXNODE_GEMINI_BASE_URL=https://fluxnode.org
PROVIDER_FLUXNODE_GEMINI_API_KEY=
PROVIDER_FLUXNODE_GROK_BASE_URL=https://fluxnode.org
PROVIDER_FLUXNODE_GROK_API_KEY=
PROVIDER_KIMI_BASE_URL=https://api.kimi.com/coding/v1
PROVIDER_KIMI_API_KEY=

SENTRY_DSN=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=ai-exam-grader-backend
DOCKER_IMAGE_FRONTEND=ai-exam-grader-frontend
